# =============================================================================
# CloudGraph — Git Ignore Configurations
# =============================================================================

# System files
*.DS_Store
Thumbs.db

# =============================================================================
# Infrastructure and local artifacts
# =============================================================================
# Variables files (contain credentials / secrets)
*.env
.env.*

# Crash logs
crash.log
crash.*.log

# Research run LLM logs (real request/response dumps, can reach tens of MB —
# see experiments/README.md; the CSVs/summary/README stay tracked)
experiments/results/logs/

# Raw RCAEval parquet downloads (~45MB for a 25-case subset, and it is
# third-party data with its own upstream home). Regenerate on demand with
# scripts/build_rcaeval_dataset.py; the derived scenario JSON it produces
# (app/demo/rcaeval_dataset_generated.json) IS tracked, so the benchmark
# stays reproducible without vendoring the source corpus.
experiments/rcaeval_data/

# =============================================================================
# Go test artifacts
# =============================================================================
# Compiled test binaries
*.test
**/*.test

# Compiled executables
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test coverage & profile reports
*.out
*.cover
*.coverprofile
coverage.txt

# Go workspace files
go.work
go.work.sum

# =============================================================================
# Linter & Security Tool Caches
# =============================================================================
# TFLint local cache directory
.tflint.d/
**/.tflint.d/

# Checkov local outputs (if any)
.checkov/
checkov_report.xml
checkov_report.json

# =============================================================================
# Python / Virtual Environment Files
# =============================================================================
.venv/
venv/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =============================================================================
# Binaries
# =============================================================================
/cloudgraph

# =============================================================================
# Package Management
# =============================================================================
node_modules/
yarn.lock
package-lock.json
yarn.lock

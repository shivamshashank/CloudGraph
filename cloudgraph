#!/usr/bin/env bash
set -euo pipefail

CLOUDGRAPH_VERSION="${CLOUDGRAPH_VERSION:-0.1.0}"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_header() {
    echo -e "${BLUE}===================================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}===================================================${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

show_help() {
  cat <<'EOF'
CloudGraph CLI

Usage:
  cloudgraph [command]

Commands:
  version        Show the installed CloudGraph version
  health         Check the CloudGraph API health endpoint
  ingest         Send a sample payload to the CloudGraph API
  setup          Install Kubernetes (kubeadm), Helm, and CloudGraph
  help           Show this help message

Examples:
  cloudgraph version
  cloudgraph health http://localhost:8000
  cloudgraph ingest http://localhost:8000 /api/v1/telemetry/logs
  sudo cloudgraph setup
EOF
}

show_version() {
  echo "cloudgraph version ${CLOUDGRAPH_VERSION}"
}

check_url() {
  local url="$1"
  if [[ -z "$url" ]]; then
    echo "Usage: cloudgraph health <base-url>" >&2
    exit 1
  fi
}

run_health() {
  local base_url="$1"
  check_url "$base_url"
  curl -fsSL "${base_url%/}/health"
}

run_ingest() {
  local base_url="$1"
  local endpoint="$2"
  if [[ -z "$base_url" || -z "$endpoint" ]]; then
    echo "Usage: cloudgraph ingest <base-url> <endpoint>" >&2
    exit 1
  fi

  local payload
  payload='{"pod_id":"demo-pod","pod_name":"demo","message":"hello from cloudgraph cli","level":"info","timestamp":'$(date +%s)',"container_name":"demo"}'
  curl -fsSL -X POST "${base_url%/}${endpoint}" \
    -H 'Content-Type: application/json' \
    --data "$payload"
}

# -----------------------------------------------------------------------------
# Setup Command Logic (kubeadm, kubectl, Helm, CloudGraph)
# -----------------------------------------------------------------------------

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

check_kubectl() {
    print_header "Checking for kubectl"
    if command_exists kubectl; then
        print_success "kubectl found"
        return 0
    else
        print_error "kubectl not found"
        return 1
    fi
}

check_k8s_cluster() {
    print_header "Checking for Kubernetes cluster"
    if ! command_exists kubectl; then
        print_error "kubectl is required to check cluster"
        return 1
    fi

    if kubectl cluster-info &>/dev/null; then
        print_success "Kubernetes cluster detected"
        return 0
    else
        print_warning "No Kubernetes cluster detected"
        return 1
    fi
}

install_kubeadm() {
    print_header "Kubernetes cluster not found"
    echo "Would you like to install Kubernetes using kubeadm?"
    echo "Options:"
    echo "  1) Install kubeadm + kubelet + kubectl locally"
    echo "  2) Skip and use existing cluster"
    echo "  3) Exit"

    read -r -p "Choose option (1-3): " choice

    case $choice in
        1)
            print_info "Installing Kubernetes..."
            install_kubernetes_local
            ;;
        2)
            print_warning "Skipping kubeadm installation"
            return 1
            ;;
        3)
            print_info "Exiting..."
            exit 0
            ;;
        *)
            print_error "Invalid option"
            install_kubeadm
            ;;
    esac
}

install_kubernetes_local() {
    OS=$(uname -s)
    if [[ "$OS" == "Darwin" ]]; then
        print_info "macOS detected - using Docker Desktop Kubernetes"
        echo "Please enable Kubernetes in Docker Desktop settings"
        exit 1
    elif [[ "$OS" == "Linux" ]]; then
        print_info "Linux detected - installing kubeadm cluster"
        install_kubeadm_linux
    else
        print_error "Unsupported OS: $OS"
        exit 1
    fi
}

install_kubeadm_linux() {
    print_info "Installing system prerequisites (swap, sysctl, conntrack, containerd)..."

    # Disable swap
    sudo swapoff -a || true
    sudo sed -i '/swap/s/^/#/' /etc/fstab || true

    # Enable kernel modules for Kubernetes & Containerd
    sudo modprobe overlay || true
    sudo modprobe br_netfilter || true
    cat <<EOF | sudo tee /etc/modules-load.d/k8s.conf >/dev/null
overlay
br_netfilter
EOF

    # Configure sysctl requirements for IP forwarding & bridging
    cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf >/dev/null
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
    sudo sysctl --system >/dev/null || true

    # Update system
    sudo apt-get update -y

    # Install required packages
    sudo apt-get install -y apt-transport-https ca-certificates curl gpg conntrack containerd

    # Configure containerd default with SystemdCgroup enabled
    sudo mkdir -p /etc/containerd
    containerd config default | sudo tee /etc/containerd/config.toml >/dev/null
    sudo sed -i 's/SystemdCgroup = false/SystemdCgroup = true/g' /etc/containerd/config.toml
    sudo systemctl restart containerd || true
    sudo systemctl enable containerd || true

    # Add Kubernetes repo
    sudo mkdir -p /etc/apt/keyrings
    curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.31/deb/Release.key | sudo gpg --yes --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
    echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.31/deb/ /' | sudo tee /etc/apt/sources.list.d/kubernetes.list

    # Install kubeadm, kubelet, kubectl
    sudo apt-get update -y
    sudo apt-get install -y kubeadm kubelet kubectl
    sudo apt-mark hold kubeadm kubelet kubectl

    # Create kubeadm config to disable conntrack adjustments in kube-proxy (required for OrbStack/WSL2/LXC)
    cat <<EOF | sudo tee /tmp/kubeadm-config.yaml >/dev/null
apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
---
apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
networking:
  podSubnet: 10.244.0.0/16
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
conntrack:
  maxPerCore: 0
EOF

    # Initialize cluster
    print_info "Initializing Kubernetes cluster with conntrack configuration..."
    sudo kubeadm init --config /tmp/kubeadm-config.yaml

    # Setup kubeconfig
    mkdir -p "$HOME/.kube"
    sudo cp /etc/kubernetes/admin.conf "$HOME/.kube/config"
    sudo chown "$(id -u):$(id -g)" "$HOME/.kube/config"

    # Install CNI plugin (Flannel v0.22.3)
    print_info "Installing Flannel CNI (v0.22.3)..."
    kubectl apply -f https://github.com/flannel-io/flannel/releases/download/v0.22.3/kube-flannel.yml

    # Remove taint from master node to allow pod scheduling
    print_info "Configuring master node..."
    kubectl taint nodes --all node-role.kubernetes.io/control-plane- || true

    # Install Local Path Provisioner to allow database PVCs to bind automatically on standalone kubeadm
    print_info "Installing Rancher Local Path Provisioner..."
    kubectl apply -f https://raw.githubusercontent.com/rancher/local-path-provisioner/v0.0.30/deploy/local-path-storage.yaml
    kubectl patch storageclass local-path -p '{"metadata": {"annotations":{"storageclass.kubernetes.io/is-default-class":"true"}}}' || true

    print_success "Kubernetes cluster initialized"
    print_info "Waiting for cluster to be ready..."
    sleep 10
    kubectl wait --for=condition=Ready nodes --all --timeout=300s || true
}

check_helm() {
    print_header "Checking for Helm"
    if command_exists helm; then
        print_success "helm found: $(helm version --short)"
        return 0
    else
        print_error "helm not found"
        install_helm
    fi
}

install_helm() {
    print_info "Installing Helm..."
    if command_exists curl; then
        curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
        print_success "Helm installed"
    else
        print_error "curl is required to install Helm"
        exit 1
    fi
}

add_helm_repo() {
    print_header "Adding CloudGraph Helm repository"
    helm repo add cloudgraph https://charts.cloudgraph.dev --force-update || {
        print_warning "Failed to add official Helm repo, will look for local chart folder"
        return 1
    }
    helm repo update
    print_success "Helm repository updated"
}

create_namespace() {
    print_header "Preparing CloudGraph namespace"
    # Ensure namespace exists
    kubectl create namespace cloudgraph-system --dry-run=client -o yaml | kubectl apply -f - >/dev/null

    # Annotate and label the namespace so Helm can adopt it without ownership clashes
    print_info "Configuring Helm ownership metadata on namespace..."
    kubectl label namespace cloudgraph-system app.kubernetes.io/managed-by=Helm --overwrite >/dev/null 2>&1 || true
    kubectl annotate namespace cloudgraph-system meta.helm.sh/release-name=cloudgraph --overwrite >/dev/null 2>&1 || true
    kubectl annotate namespace cloudgraph-system meta.helm.sh/release-namespace=cloudgraph-system --overwrite >/dev/null 2>&1 || true

    print_success "Namespace 'cloudgraph-system' ready and configured for Helm"
}

install_cloudgraph() {
    print_header "Installing CloudGraph Core Stack"

    local chart_path="./deployments/helm/cloudgraph"
    if [[ ! -d "$chart_path" ]]; then
        chart_path="/home/shivam_shashank/CloudGraph/deployments/helm/cloudgraph"
    fi

    if [[ -d "$chart_path" ]]; then
        print_info "Using local Helm chart from $chart_path..."
        print_info "Updating and building Helm chart dependencies..."
        local current_dir="$PWD"
        cd "$chart_path"

        # Add subchart repositories explicitly (required when running as root/sudo)
        helm repo add neo4j https://helm.neo4j.com/neo4j || true
        helm repo add bitnami https://charts.bitnami.com/bitnami || true
        helm repo add qdrant https://qdrant.github.io/qdrant-helm || true
        helm repo update

        helm dependency update
        helm dependency build
        print_info "Installing local Helm chart..."
        helm install cloudgraph . \
            --namespace cloudgraph-system \
            --create-namespace
        cd "$current_dir"
    else
        print_info "Installing CloudGraph via online Helm repo..."
        helm install cloudgraph cloudgraph/cloudgraph \
            --namespace cloudgraph-system \
            --create-namespace
    fi
    print_success "CloudGraph deployed successfully"
}

wait_for_deployment() {
    print_header "Waiting for CloudGraph pods to be ready"
    kubectl wait --for=condition=available --timeout=600s \
        deployment -l app.kubernetes.io/instance=cloudgraph \
        -n cloudgraph-system || true
    print_success "CloudGraph pods are ready"
}

run_setup() {
    if [ "$(id -u)" -ne 0 ]; then
        print_error "The 'setup' command must be run with root privileges (sudo)." >&2
        exit 1
    fi

    check_kubectl || true
    if ! check_k8s_cluster; then
        if ! install_kubeadm; then
            print_error "Failed to initialize Kubernetes cluster."
            exit 1
        fi
    fi

    check_helm
    create_namespace
    install_cloudgraph
    wait_for_deployment

    print_header "Setup Completed Successfully!"
    echo "You can check your pods with:"
    echo "  kubectl get pods -n cloudgraph-system"
    echo ""
}

# -----------------------------------------------------------------------------
# Main Routing
# -----------------------------------------------------------------------------

main() {
  case "${1:-help}" in
    version)
      show_version
      ;;
    health)
      run_health "${2:-}"
      ;;
    ingest)
      run_ingest "${2:-}" "${3:-}"
      ;;
    setup)
      run_setup
      ;;
    help|--help|-h)
      show_help
      ;;
    *)
      echo "Unknown command: $1" >&2
      show_help >&2
      exit 1
      ;;
  esac
}

main "$@"
